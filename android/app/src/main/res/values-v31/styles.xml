<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) uses the system SplashScreen API, which requires
         an opaque window background. Without windowSplashScreenBackground the
         system falls back to windowBackground (a layer-list), which it fails to
         resolve and treats as transparent — leaking the task snapshot behind it. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
